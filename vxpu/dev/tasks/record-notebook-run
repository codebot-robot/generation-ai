.cell.markdown code, .outputs code { background:var(--input); padding:1px 4px; border-radius:4px; }
__PYGMENTS_LIGHT__
@media (prefers-color-scheme: dark) { __PYGMENTS_DARK__ }
.cell .input pre.highlight { background: transparent; }
</style>
<header>
  <h1>__TITLE__</h1>
  <button class="primary" id="play">Play</button>
  <label>speed <select id="speed"><option>1</option><option>2</option><option selected>4</option><option>8</option><option>16</option></select>×</label>
  <label>cap gaps at <select id="gap"><option value="0.5">0.5 s</option><option value="2" selected>2 s</option><option value="5">5 s</option><option value="1e9">no cap</option></select></label>
  <input type="range" id="seek" min="0" max="1000" value="0">
  <span class="meta" id="time"></span>
  <label><input type="checkbox" id="follow" checked> follow</label>
  <span class="meta">recorded __RECORDED__ · real duration __DURATION__</span>__ABORTED__
</header>
<main id="main"></main>
<script id="recording" type="application/json">__RECORDING__</script>
<script>
const rec = JSON.parse(document.getElementById('recording').textContent);
const main = document.getElementById('main');
const cells = rec.cells.map((c, i) => {
  const el = document.createElement('div');
  el.className = 'cell ' + c.type; el.id = 'cell-' + i;
  if (c.type === 'code') {
    el.innerHTML = '<div class="prompt">[ ]:</div><div class="input"><pre class="highlight">' + c.html + '</pre></div><div class="outputs"></div>';
  } else {
    el.innerHTML = '<div class="prompt"></div><div class="body">' + c.html + '</div>';
  }
  main.appendChild(el);
  return el;
});
// Effective timeline: real gaps between events, each capped.
let eff = [];
function buildTimeline() {
  const cap = parseFloat(document.getElementById('gap').value);
  eff = []; let acc = 0, prev = 0;
  for (const e of rec.events) { acc += Math.min(Math.max(e.t - prev, 0), cap); prev = e.t; eff.push(acc); }
}
// Apply a stream chunk the way a notebook output area does: \r returns
// to the start of the current line, \b deletes one character.
function appendStream(pre, chunk) {
  let text = pre.textContent;
  for (const ch of chunk) {
    if (ch === '\r') { const nl = text.lastIndexOf('\n'); text = text.slice(0, nl + 1); }
    else if (ch === '\b') { text = text.slice(0, -1); }
    else { text += ch; }
  }
  pre.textContent = text;
}
function fmt(s) { s = Math.max(0, Math.round(s)); return String(Math.floor(s / 60)).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0'); }
const counts = {}; let pendingClear = {};
function reset() {
  pendingClear = {};
  for (const el of cells) { el.classList.remove('running'); const o = el.querySelector('.outputs'); if (o) o.innerHTML = ''; const p = el.querySelector('.prompt'); if (p && el.classList.contains('code')) p.textContent = '[ ]:'; }
}
function beforeOutput(cellIndex, out) {
  if (pendingClear[cellIndex]) { out.innerHTML = ''; pendingClear[cellIndex] = false; }
}
function apply(e) {
  const el = cells[e.cell]; if (!el) return;
  const out = el.querySelector('.outputs'); const prompt = el.querySelector('.prompt');
  if (e.type === 'input') { el.classList.add('running'); prompt.textContent = '[*]:'; counts[e.cell] = e.count; }
  else if (e.type === 'status' && e.state === 'idle') { el.classList.remove('running'); if (counts[e.cell] != null) prompt.textContent = '[' + counts[e.cell] + ']:'; }
  else if (e.type === 'stream') {
    beforeOutput(e.cell, out);
    let pre = out.lastElementChild;
    if (!pre || !pre.classList.contains('stream') || !pre.classList.contains(e.name)) { pre = document.createElement('pre'); pre.className = 'stream ' + e.name; out.appendChild(pre); }
    appendStream(pre, e.text);
  }
  else if (e.type === 'display' || e.type === 'update') {
    const existing = e.display_id ? main.querySelector('.display[data-display-id="' + CSS.escape(e.display_id) + '"]') : null;
    if (e.type === 'update') { if (existing) existing.innerHTML = e.html; }
    else { beforeOutput(e.cell, out); const d = document.createElement('div'); d.className = 'display'; if (e.display_id) d.dataset.displayId = e.display_id; d.innerHTML = e.html; out.appendChild(d); }
  }
  else if (e.type === 'error') { beforeOutput(e.cell, out); const pre = document.createElement('pre'); pre.className = 'error'; pre.textContent = e.text; out.appendChild(pre); }
  else if (e.type === 'clear') { if (e.wait) pendingClear[e.cell] = true; else { out.innerHTML = ''; pendingClear[e.cell] = false; } }
  if (document.getElementById('follow').checked && e.type !== 'status') el.scrollIntoView({ block: 'center', behavior: 'smooth' });
}
let pos = 0, clock = 0, playing = false, last = null, raf = null;
const seek = document.getElementById('seek'), timeEl = document.getElementById('time'), playBtn = document.getElementById('play');
function total() { return eff.length ? eff[eff.length - 1] : 0; }
function render() {
  while (pos < rec.events.length && eff[pos] <= clock) apply(rec.events[pos++]);
  seek.value = total() ? Math.round(1000 * clock / total()) : 0;
  const real = pos ? rec.events[pos - 1].t : 0;
  timeEl.textContent = fmt(clock) + ' / ' + fmt(total()) + ' (real ' + fmt(real) + ')';
  if (pos >= rec.events.length && playing) { playing = false; playBtn.textContent = 'Replay'; }
}
function tick(now) {
  if (!playing) return;
  if (last != null) clock += (now - last) / 1000 * parseFloat(document.getElementById('speed').value);
  last = now; render(); raf = requestAnimationFrame(tick);
}
function seekTo(t) { reset(); pos = 0; clock = t; render(); }
playBtn.onclick = () => {
  if (pos >= rec.events.length) { seekTo(0); }
  playing = !playing; playBtn.textContent = playing ? 'Pause' : 'Play'; last = null;
  if (playing) raf = requestAnimationFrame(tick);
};
seek.oninput = () => { seekTo(total() * seek.value / 1000); };
document.getElementById('gap').onchange = () => { const frac = total() ? clock / total() : 0; buildTimeline(); seekTo(total() * frac); };
document.addEventListener('keydown', (ev) => { if (ev.code === 'Space' && ev.target.tagName !== 'SELECT') { ev.preventDefault(); playBtn.click(); } });
buildTimeline(); render();
</script>
"""


def pygments_css(style):
    """Token colours only: no background box, no unprefixed `pre` rule."""
    defs = HtmlFormatter(style=style, nobackground=True).get_style_defs(".highlight")
    return "\n".join(line for line in defs.splitlines()
                     if line.startswith(".highlight ."))


def write_player(recording, path):
    aborted = recording.get("aborted")
    page = (PLAYER
            .replace("__TITLE__", html.escape(recording["notebook"]))
            .replace("__RECORDED__", html.escape(recording["recorded"]))
            .replace("__DURATION__", f"{int(recording['duration'] // 60)}m{int(recording['duration'] % 60):02d}s")
            .replace("__ABORTED__", f' <span class="meta" style="color:#b3261e">· aborted: {html.escape(aborted)}</span>' if aborted else "")
            .replace("__PYGMENTS_LIGHT__", pygments_css("default"))
            .replace("__PYGMENTS_DARK__", pygments_css("monokai"))
            # \u003c keeps "</script>" and "<!--" in recorded content from
            # ending or escaping the data element.
            .replace("__RECORDING__", json.dumps(recording).replace("<", "\\u003c")))
    with open(path, "w", encoding="utf-8") as f:
        f.write(page)


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("notebook")
    parser.add_argument("--out", default=DEFAULT_OUT,
                        help="output directory (default: a per-user cache dir)")
    parser.add_argument("--timeout", type=int, default=3600, help="per-cell timeout")
    parser.add_argument("--kernel", default=None, help="kernel name (default: the notebook's)")
    parser.add_argument("--stop-on-error", action="store_true",
                        help="stop at the first failing cell (the recording up to "
                             "and including it is still written)")
    args = parser.parse_args()

    # Fail on an unusable output directory before the (possibly long) run.
    os.makedirs(args.out, exist_ok=True)
    stem = os.path.join(args.out, os.path.splitext(os.path.basename(args.notebook))[0])
    recording = record(args.notebook, args.timeout, args.kernel,
                       allow_errors=not args.stop_on_error)
    with open(stem + ".recording.json", "w", encoding="utf-8") as f:
        json.dump(recording, f)
    write_player(recording, stem + ".html")
    print(f"recording: {stem}.recording.json ({len(recording['events'])} events, "
          f"{recording['duration']:.0f}s real time, {recording['errors']} errors"
          f"{', aborted' if recording['aborted'] else ''})")
    print(f"player:    {stem}.html")
    return 1 if recording["errors"] or recording["aborted"] else 0


if __name__ == "__main__":
    sys.exit(main())

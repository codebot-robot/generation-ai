import argparse
import os
import time
import subprocess
import sys

def run_command(command, capture_output=False):
    print(f"Running: {command}")
    try:
        if capture_output:
            return subprocess.check_output(command, shell=True, text=True).strip()
        else:
            subprocess.check_call(command, shell=True)
    except subprocess.CalledProcessError as e:
        print(f"Error running command: {command}")
        sys.exit(1)

def main():
    parser = argparse.ArgumentParser(description="Run MLX inference test in Kubernetes")
    parser.add_argument("--device", type=str, default="gpu", choices=["cpu", "gpu"], help="Device to use (cpu or gpu)")
    args = parser.parse_args()

    # 1. Get Project ID
    project_id = run_command("gcloud config get-value project", capture_output=True)
    if not project_id:
        print("Could not determine GCloud project ID.")
        sys.exit(1)
    
    timestamp = int(time.time())
    image_tag = f"gcr.io/{project_id}/generation-ai/mlx-inference:{timestamp}"
    
    # 2. Build Image
    script_dir = os.path.dirname(os.path.abspath(__file__))
    # script is in experiments/inference-test/mlx/dev/tasks/
    # we want experiments/inference-test/mlx/
    base_dir = os.path.abspath(os.path.join(script_dir, "../../"))
    
    print(f"Base dir: {base_dir}")
    
    dockerfile_path = os.path.join(base_dir, "images/mlx-inference/Dockerfile")
    
    # Build and Push
    run_command(f"docker build -t {image_tag} -f {dockerfile_path} {base_dir}")
    run_command(f"docker push {image_tag}")
    
    # 3. Deploy Job
    manifest_path = os.path.join(base_dir, "examples/simple/manifest.yaml")
    print(f"Using manifest: {manifest_path}")

    with open(manifest_path, 'r') as f:
        manifests = f.read().split('---')
    
    # Pick the right manifest based on device
    job_name = f"mlx-inference-{args.device}"
    selected_manifest = None
    for m in manifests:
        if f"name: {job_name}" in m:
            selected_manifest = m
            break
            
    if not selected_manifest:
        print(f"Could not find manifest for job {job_name}")
        sys.exit(1)
        
    selected_manifest = selected_manifest.replace("mlx-inference:latest", image_tag)
    
    # Write to temp file
    temp_manifest = f"/tmp/mlx-manifest-{timestamp}.yaml"
    with open(temp_manifest, 'w') as f:
        f.write(selected_manifest)
        
    print(f"Cleaning up previous runs for {job_name}...")
    run_command(f"kubectl delete job {job_name} --ignore-not-found")
    
    print("Applying manifest...")
    output = run_command(f"kubectl apply -f {temp_manifest}", capture_output=True)
    print(output)
    
    k8s_job_name = f"job.batch/{job_name}"
    
    print(f"Job {k8s_job_name} created. Waiting for completion...")
    
    # 4. Capture and print output
    try:
        # Wait for job to complete
        run_command(f"kubectl wait --for=condition=complete --timeout=600s {k8s_job_name}")
        
        print("Fetching logs...")
        run_command(f"kubectl logs -l job-name={job_name}")
        
    except Exception as e:
        print(f"An error occurred: {e}")
        try:
             run_command(f"kubectl logs -l job-name={job_name}")
        except:
            pass
    finally:
        if os.path.exists(temp_manifest):
            os.remove(temp_manifest)

if __name__ == "__main__":
    main()

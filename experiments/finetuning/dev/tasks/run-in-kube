import argparse
import os
import time
import subprocess
import sys

def run_command(command, capture_output=False):
    print(f"Running: {command}")
    try:
        if capture_output:
            return subprocess.check_output(command, shell=True, text=True).strip()
        else:
            subprocess.check_call(command, shell=True)
    except subprocess.CalledProcessError as e:
        print(f"Error running command: {command}")
        sys.exit(1)

def main():
    parser = argparse.ArgumentParser(description="Run fine-tuning test in Kubernetes")
    args = parser.parse_args()

    # 1. Get Project ID
    project_id = run_command("gcloud config get-value project", capture_output=True)
    if not project_id:
        print("Could not determine GCloud project ID.")
        sys.exit(1)
    
    timestamp = int(time.time())
    server_image = f"gcr.io/{project_id}/generation-ai/finetuning-server:{timestamp}"
    client_image = f"gcr.io/{project_id}/generation-ai/finetuning-client:{timestamp}"
    
    # 2. Build Images
    script_dir = os.path.dirname(os.path.abspath(__file__))
    base_dir = os.path.abspath(os.path.join(script_dir, "../../"))
    
    print(f"Base dir: {base_dir}")
    
    # Build and Push Server
    server_dockerfile = os.path.join(base_dir, "images/server/Dockerfile")
    run_command(f"docker build -t {server_image} -f {server_dockerfile} {base_dir}")
    run_command(f"docker push {server_image}")
    
    # Build and Push Client
    client_dockerfile = os.path.join(base_dir, "images/client/Dockerfile")
    run_command(f"docker build -t {client_image} -f {client_dockerfile} {base_dir}")
    run_command(f"docker push {client_image}")
    
    # 3. Deploy
    manifest_path = os.path.join(base_dir, "k8s/manifest.yaml")
    with open(manifest_path, 'r') as f:
        manifest_content = f.read()
    
    manifest_content = manifest_content.replace("finetuning-server:latest", server_image)
    manifest_content = manifest_content.replace("finetuning-client:latest", client_image)
    
    # Write to temp file
    temp_manifest = f"/tmp/finetuning-{timestamp}.yaml"
    with open(temp_manifest, 'w') as f:
        f.write(manifest_content)
        
    print("Cleaning up previous runs...")
    run_command("kubectl delete deployment finetuning-server --ignore-not-found")
    run_command("kubectl delete service finetuning-server --ignore-not-found")
    run_command("kubectl delete job finetuning-client --ignore-not-found")
    
    print("Applying manifest...")
    run_command(f"kubectl apply -f {temp_manifest}")
    
    print("Waiting for client job to complete...")
    try:
        # Wait for job to complete
        run_command("kubectl wait --for=condition=complete --timeout=600s job/finetuning-client")
        
        print("Fetching client logs...")
        run_command("kubectl logs -l job-name=finetuning-client")
        
    except Exception as e:
        print(f"An error occurred: {e}")
        try:
             run_command("kubectl logs -l job-name=finetuning-client")
        except:
            pass
    finally:
        # Cleanup temp file
        if os.path.exists(temp_manifest):
            os.remove(temp_manifest)

if __name__ == "__main__":
    main()
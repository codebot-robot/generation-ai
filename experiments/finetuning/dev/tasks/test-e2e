set -e

# Get the directory of this script
SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
# Go to the experiment root
EXPERIMENT_ROOT=$(readlink -f "${SCRIPT_DIR}/../..")
cd "${EXPERIMENT_ROOT}"

# Check for dependencies
for cmd in docker kind kubectl go; do
    if ! command -v $cmd &> /dev/null; then
        echo "Error: $cmd is not installed." >&2
        exit 1
    fi
done

echo "Running E2E tests for finetuning experiment..."
export RUN_E2E=1
go test -v -count=1 -timeout 20m ./tests/e2e/...
